// --------------------------
// 1️⃣ AI AGENT — 24/7 BRAIN 🧠
// --------------------------
class AIAgent {
private:
    bool isActive;
    
public:
    AIAgent() : isActive(true) {}
    
    virtual ~AIAgent() = default;
    
    void assistUser() {
        if (!isActive) throw runtime_error("AI Agent is not active");
        cout << "🤖 AI: Always here! Guiding, helping, answering instantly!\n";
    }
    
    void processOrder(const string& orderId) {
        if (!isActive) throw runtime_error("AI Agent is not active");
        if (orderId.empty()) throw invalid_argument("Order ID cannot be empty");
        cout << "🤖 AI: Processing order " << orderId << " with zero mistakes!\n";
    }
    
    bool getStatus() const { return isActive; }
    void deactivate() { isActive = false; }
};

// --------------------------
// 2️⃣ VERIFIED SELLER & PRODUCTS — 100% REAL ✅🌍
// --------------------------
class Seller {
private:
    string country;
    string sellerId;
    bool verified;
    vector<string> products;
    bool isLive;
    
public:
    Seller(const string& loc, const string& id) 
        : country(loc), sellerId(id), verified(false), isLive(false) {
        if (loc.empty() || id.empty()) 
            throw invalid_argument("Country and Seller ID cannot be empty");
    }
    
    virtual ~Seller() = default;
    
    void verifyIdentity(const string& verificationCode) {
        if (verificationCode.empty()) 
            throw invalid_argument("Verification code required");
        verified = true;
        cout << "✅ Seller " << sellerId << " from " << country 
             << " verified — All products are 100% genuine!\n";
    }
    
    void postProduct(const string& item) {
        if (!verified) throw runtime_error("Seller not verified. Cannot post products.");
        if (item.empty()) throw invalid_argument("Product name cannot be empty");
        
        products.push_back(item);
        cout << "📢 Posted: " << item << " — Trusted Worldwide!\n";
    }
    
    void goLive() {
        if (!verified) throw runtime_error("Seller not verified. Cannot go live.");
        isLive = true;
        cout << "🎥 LIVE STREAM STARTED — Seller " << sellerId 
             << " is now live! Promote, interact, and sell!\n";
    }
    
    void goOffline() {
        isLive = false;
        cout << "⏹️ LIVE STREAM ENDED — Seller " << sellerId << " is now offline.\n";
    }
    
    bool isVerified() const { return verified; }
    bool getIsLive() const { return isLive; }
    const vector<string>& getProducts() const { return products; }
    string getCountry() const { return country; }
};

// --------------------------
// 3️⃣ LIVE STREAM — GIFTS + DIRECT BUY 🎁🛍️
// --------------------------
class LiveStream {
private:
    double totalRevenue;
    int totalTransactions;
    
public:
    LiveStream() : totalRevenue(0.0), totalTransactions(0) {}
    
    virtual ~LiveStream() = default;
    
    void sendGift(double amount, const string& giftName) {
        if (amount <= 0) throw invalid_argument("Gift amount must be positive");
        if (giftName.empty()) throw invalid_argument("Gift name cannot be empty");
        
        totalRevenue += amount;
        totalTransactions++;
        cout << "🎁 Gift '" << giftName << "' Sent! +$" 
             << fixed << setprecision(2) << amount << "\n";
    }
    
    void buyNow(const string& product, double price) {
        if (product.empty()) throw invalid_argument("Product name cannot be empty");
        if (price <= 0) throw invalid_argument("Price must be positive");
        
        totalRevenue += price;
        totalTransactions++;
        cout << "⚡ BUY DIRECT: " << product << " for $" 
             << fixed << setprecision(2) << price << " — Order confirmed!\n";
    }
    
    double getTotalRevenue() const { return totalRevenue; }
    int getTotalTransactions() const { return totalTransactions; }
};

// --------------------------
// 4️⃣ HANDLER — SYSTEM MANAGEMENT ⚙️
// --------------------------
class Handler {
private:
    bool isRunning;
    int operatingCount;
    
public:
    Handler() : isRunning(true), operatingCount(0) {}
    
    virtual ~Handler() = default;
    
    void manageAll() {
        if (!isRunning) throw runtime_error("Handler is not running");
        operatingCount++;
        cout << "🔧 Handler Running Smoothly — System Stability Maintained! (Operations: " 
             << operatingCount << ")\n";
    }
    
    void start() {
        isRunning = true;
        operatingCount = 0;
        cout << "✅ Handler Started\n";
    }
    
    void stop() {
        isRunning = false;
        cout << "⏹️ Handler Stopped\n";
    }
    
    bool getStatus() const { return isRunning; }
};

// --------------------------
// 5️⃣ LOGISTICS & JOBS 📦🚚
// --------------------------
class LogisticsJobs {
private:
    vector<string> deliveryAgents;
    vector<pair<string, string>> shipments; // item, destination
    
public:
    virtual ~LogisticsJobs() = default;
    
    void registerForJob(const string& person) {
        if (person.empty()) throw invalid_argument("Person name cannot be empty");
        
        deliveryAgents.push_back(person);
        cout << "💼 JOB SECURED: " << person << " — Ready to deliver and earn!\n";
    }
    
    void moveGoods(const string& item, const string& destination) {
        if (item.empty() || destination.empty()) 
            throw invalid_argument("Item and destination cannot be empty");
        
        shipments.push_back({item, destination});
        cout << "🚚 Moving & Delivering: " << item << " → " << destination << "\n";
    }
    
    int getDeliveryAgentCount() const { return deliveryAgents.size(); }
    int getShipmentCount() const { return shipments.size(); }
    const vector<string>& getAgents() const { return deliveryAgents; }
};

